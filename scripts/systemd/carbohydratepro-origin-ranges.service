[Unit]
Description=Synchronize CloudFront origin ranges for CarbohydratePro
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=/etc/carbohydratepro/origin-maintenance.env
ExecStart=/usr/bin/python3 /usr/local/libexec/carbohydratepro/sync-origin-ranges.py --instance carbohydratepro-al2023-20261022 --apply
TimeoutStartSec=600
